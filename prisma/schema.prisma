generator client {
  provider = "prisma-client-js"
  // The runtime engine must be deterministic, not an accident of where
  // the image was built. The Docker build stage (oven/bun:1, Debian
  // bookworm) generates "native" = debian-openssl-3.0.x; the
  // node:22-slim runtime detects via the openssl CLI (installed in
  // deploy/Dockerfile.web) to the same target. CI runs #1-#5 all died
  // on the mismatch: slim has no openssl CLI, detection fell back to a
  // guess (debian-openssl-1.1.x), and every DB call in the web
  // container 500ed.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// The server is a blind relay. It stores room lifecycle + a member
// registry (public keys, for fingerprint verification). It never
// stores message content — messages exist only as live relayed
// ciphertext and in the memory of connected members.

model Room {
  id           String    @id // public room code used in invite links
  verifier     String? // encrypted known-plaintext set by the creator (JSON {iv, ct})
  creatorToken String // secret held only by the creator, authorizes burn + lifetime changes
  epoch        Int       @default(1) // key-derivation epoch; bumped on member leave (key rotation)
  burned       Boolean   @default(false)
  burnedAt     DateTime?
  reportReason String?   // set when terminated via the abuse endpoint — operator forensics, capped at the route
  expiresAt    DateTime? // chosen by the creator at creation; null = until burned. Expired rooms are refused and swept.
  createdAt    DateTime  @default(now())
  members      Member[]
}

model Member {
  id         String   @id @default(cuid())
  roomId     String
  pubkey     String // ECDSA P-256 public key (JWK JSON) — identity lives here
  ecdhPub    String? // session ECDH public key (raw b64) — key delivery; changes per page load
  alias      String // deterministic alias derived from the key fingerprint
  colorIdx   Int // deterministic ink index 0-7
  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())
  active     Boolean  @default(true)
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, pubkey])
  @@index([roomId])
}
