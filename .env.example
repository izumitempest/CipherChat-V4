# CipherChat — environment configuration.
#
# Copy to .env (dev) or deploy/.env (production) and adjust.
# Everything the app needs is a variable — no edit-and-rebuild deploys.

# --- Next.js app ------------------------------------------------------------

# SQLite database file (Prisma). In production (deploy/docker-compose.yml)
# this lives on the db-data volume: file:/app/db/custom.db
DATABASE_URL=file:./db/custom.db

# Shared secret between the Next.js API tier and the relay's internal
# presence endpoint (port 3004, server-to-server only, never exposed).
# Used by /api/rooms/:id/evict to confirm who is really connected.
# Generate with: openssl rand -hex 24
RELAY_INTERNAL_TOKEN=change-me-openssl-rand-hex-24

# Where the browser finds the socket.io relay.
#   Default: /relay/     — same-origin path your reverse proxy strips and
#                          forwards to the relay service (see deploy/Caddyfile:
#                          handle_path /relay/* → relay:3003)
#   Absolute URL also works: https://relay.example.com/
# Dev-sandbox gateway only: /?XTransformPort=3003 (never in production)
NEXT_PUBLIC_RELAY_URL=/relay/

# --- deploy/docker-compose.yml additionally uses ---------------------------

# CADDY_SITE — the site address Caddy serves with automatic TLS.
#   localhost  → internal CA (browser warning; fine for testing)
#   chat.example.com → Let's Encrypt, requires the host to be reachable
# CADDY_SITE=localhost

# Public origin of the site — used only to resolve social/OG image URLs.
#   https://chat.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
