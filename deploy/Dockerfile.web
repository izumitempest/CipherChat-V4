# CipherChat web — Next.js standalone + Prisma (SQLite).
#
# Build context is the REPOSITORY ROOT (see docker-compose.yml), because
# the Prisma schema and src/ are needed during build.
#
#   docker build -f deploy/Dockerfile.web -t cipherchat-web .

# --- deps --------------------------------------------------------------------
FROM oven/bun:1 AS deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# --- build -------------------------------------------------------------------
FROM oven/bun:1 AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json bun.lock next.config.ts tsconfig.json eslint.config.mjs postcss.config.mjs components.json ./
COPY prisma ./prisma
COPY src ./src
COPY public ./public

# Compile-time configuration (inlined into the client bundle).
ARG NEXT_PUBLIC_RELAY_URL=/relay/
ENV NEXT_PUBLIC_RELAY_URL=$NEXT_PUBLIC_RELAY_URL
# A throwaway DB: `next build` only needs the schema, never real data.
ENV DATABASE_URL=file:/tmp/build.db

# Prisma client (engines are linux-gnu — matches the node:22-slim runtime).
RUN bunx prisma generate
# `bun run build` also copies .next/static + public into the standalone dir.
RUN bun run build

# Bake an empty, schema-pushed SQLite file as the first-boot template.
RUN bunx prisma db push --accept-data-loss --skip-generate

# --- runtime -----------------------------------------------------------------
FROM node:22-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    DATABASE_URL=file:/app/db/custom.db

COPY --from=build /app/.next/standalone ./
# Prisma engines are sometimes missed by Next's file tracing — carry them.
COPY --from=build /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=build /app/node_modules/@prisma ./node_modules/@prisma
COPY --from=build /tmp/build.db /app/db/custom.db.template
COPY deploy/entrypoint-web.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh \
    && mkdir -p /app/db \
    && cp /app/db/custom.db.template /app/db/custom.db

# Liveness = the API tier answers a READ that touches the database.
# GET a room id that cannot exist (lowercase never appears in the
# Crockford base32 ids) and expect exactly 404: Prisma answered "no
# such room". Anything else fails closed — 5xx is a broken DB, 429 is
# a choked limiter, a 2xx would mean the impossible id exists. The
# previous probe POSTed /api/rooms with no body, took the default-TTL
# path, and created a junk room every 30s; this one is read-only and
# leaves the expired-room janitor on its designed cadence (real room
# creations).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
  CMD node -e "fetch('http://127.0.0.1:3000/api/rooms/healthprobe0').then(r=>{process.exit(r.status===404?0:1)}).catch(()=>process.exit(1))" || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["node", "server.js"]
