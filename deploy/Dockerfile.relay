# CipherChat relay — a blind post office (socket.io on :3003, internal
# token-guarded presence snapshot on :3004).
#
# Build context is the REPOSITORY ROOT (see docker-compose.yml) because
# the relay imports src/lib/rate-limit.ts.
#
#   docker build -f deploy/Dockerfile.relay -t cipherchat-relay .

FROM oven/bun:1 AS runtime
WORKDIR /app

# Install first (layer cache), then the two source files.
COPY mini-services/relay-service/package.json mini-services/relay-service/bun.lock ./mini-services/relay-service/
RUN cd mini-services/relay-service && bun install --frozen-lockfile

COPY mini-services/relay-service/index.ts ./mini-services/relay-service/index.ts
COPY src/lib/rate-limit.ts ./src/lib/rate-limit.ts

ENV NODE_ENV=production
EXPOSE 3003 3004

# Liveness = the message plane answers a real engine.io handshake:
# HTTP 200 AND a body opening with the OPEN packet ("0{"). Anything
# else fails closed. The :3004 presence port is token-guarded by design
# and deliberately not probed — a 403 there is the guard working, not
# a fault.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD bun -e "fetch('http://127.0.0.1:3003/?EIO=4&transport=polling').then(r=>r.text().then(t=>process.exit(r.status===200&&t.startsWith('0{')?0:1))).catch(()=>process.exit(1))" || exit 1

CMD ["bun", "mini-services/relay-service/index.ts"]
