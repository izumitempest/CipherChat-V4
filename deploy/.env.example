# CipherChat deploy configuration — copy to .env next to this file.
#   cp .env.example .env

# REQUIRED — shared secret between the web app and the relay's internal
# presence endpoint. Generate with:  openssl rand -hex 24
RELAY_INTERNAL_TOKEN=

# The public site Caddy serves with automatic TLS.
#   localhost        → internal CA (browser warning; testing only)
#   chat.example.com → Let's Encrypt (host must be reachable on 80/443)
CADDY_SITE=localhost

# Where the browser finds the relay (compile-time, baked into the web
# image). The default serves it same-origin under /relay/ via Caddy.
# Only change this if the relay lives on another origin.
NEXT_PUBLIC_RELAY_URL=/relay/

# Public origin (resolves OG/social image URLs in metadata).
NEXT_PUBLIC_SITE_URL=https://localhost

# The origins allowed to open a socket into the relay. Comma separated.
# Leave empty and the relay takes the local app and the CADDY_SITE above.
# RELAY_ALLOWED_ORIGINS=https://chat.example.com
