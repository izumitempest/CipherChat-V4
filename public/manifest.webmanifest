{
  "name": "CipherChat",
  "short_name": "CipherChat",
  "description": "End-to-end encrypted, ephemeral rooms. No accounts, no history, no trace.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "launch_handler": { "client_mode": "focus-existing" },
  "orientation": "portrait-primary",
  "categories": ["social", "communication"],
  "background_color": "#F4F1EB",
  "theme_color": "#F4F1EB",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New room",
      "short_name": "New room",
      "description": "Seal a fresh room",
      "url": "/#/new",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Your rooms",
      "short_name": "Rooms",
      "description": "Open the desk",
      "url": "/#/rooms",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
